# What rbs-inline cannot read of the Data classes of Support.
module Branchout
  module Emitters
    module Support
      # Its block defines to_s, which rbs-inline does not read.
      class SymbolKey < Data
        def to_s: () -> String
      end

      # Its block defines an initialize that makes follows optional, which
      # rbs-inline does not read.
      class Key < Data
        attr_reader text(): String

        attr_reader follows(): bool

        def self.new: (String text, ?bool follows) -> instance
                    | (text: String, ?follows: bool) -> instance

        def self.members: () -> [ :text, :follows ]

        def members: () -> [ :text, :follows ]

        def initialize: (text: String, ?follows: bool) -> void
      end
    end
  end
end
